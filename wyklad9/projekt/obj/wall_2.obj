# Prostopadloscian OBJ - Obrocony o 90 stopni (Y)
o Prostopadloscian_Rotated

# Wierzcholki (Zamienione X i Z)
v  1.0 -1.0  2.0
v  1.0 -1.0 -2.0
v  1.0  1.0  2.0
v  1.0  1.0 -2.0
v -1.0  1.0  2.0
v -1.0  1.0 -2.0
v -1.0 -1.0  2.0
v -1.0 -1.0 -2.0

# Wspolrzedne UV (Bez zmian, tiling zostaje przypisany do tych samych scian)
vt 0.0 0.0
vt 2.0 0.0
vt 0.0 1.0
vt 2.0 1.0
vt 0.0 0.0
vt 1.0 0.0
vt 0.0 1.0
vt 1.0 1.0

# Normalne (Rowniez obrocone o 90 stopni w Y)
vn  1.0  0.0  0.0
vn -1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0

# Scianki (Indeksy v/vt/vn pozostaja te same, ale ich wartosci powyzej sie zmienily)

# PRZOD (Teraz patrzy w strone X)
f 1/1/1 2/2/1 4/4/1
f 4/4/1 3/3/1 1/1/1

# TYL
f 8/1/2 7/2/2 5/4/2
f 5/4/2 6/3/2 8/1/2

# GORA
f 3/1/3 4/2/3 6/4/3
f 6/4/3 5/3/3 3/1/3

# DOL
f 7/1/4 8/2/4 2/4/4
f 2/4/4 1/3/4 7/1/4

# PRAWA
f 2/5/5 8/6/5 6/8/5
f 6/8/5 4/7/5 2/5/5

# LEWA
f 7/5/6 1/6/6 3/8/6
f 3/8/6 5/7/6 7/5/6